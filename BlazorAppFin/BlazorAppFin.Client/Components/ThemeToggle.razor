@using BlazorAppFin.Client.Services;
@inject IJSRuntime JS
@inject ThemeState ThemeState

<button @onclick="ToggleTheme" title="Переключить тему">
    @if (ThemeState.IsDark)
    {
        <span>☀️ Светлая тема</span>
    }
    else
    {
        <span>🌙 Темная тема</span>
    }
</button>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var currentTheme = await JS.InvokeAsync<string>("themeManager.getTheme");
            
            // Записываем тему в глобальный сервис
            ThemeState.IsDark = currentTheme == "dark";
            
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        ThemeState.IsDark = !ThemeState.IsDark;
        string themeToSend = ThemeState.IsDark ? "dark" : "light";

        await JS.InvokeVoidAsync("themeManager.setTheme", themeToSend);
    }
}