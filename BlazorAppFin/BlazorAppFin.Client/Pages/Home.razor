@page "/"
@using BlazorAppFin.Client.Shared.DTOs
@using BlazorAppFin.Client.Shared.Interfaces
@inject ITransactionService TransactionService

<PageTitle>Dashboard</PageTitle>


@if (transactions == null)
{
	<h1>Загрузка...</h1>
}
else
{

	<h1>Статистика</h1>

	<div class="overview">

		<div class="overview-card">
			<h2 class="@(Balance < 0 ? "expense-text" : "income-text")">Баланс</h2>
			<h3 class="@(Balance < 0 ? "expense-text" : "income-text")">@Balance</h3>
		</div>

		<div class="overview-card">
			<h2 class="income-text">Доходы</h2>
			<h3 class="income-text">@Incomes</h3>
		</div>

		<div class="overview-card">
			<h2 class="expense-text">Траты</h2>
			<h3 class="expense-text">@Expenses</h3>
		</div>

	</div>

	
	<div class="dashboard-grid">

		<div class="grid-left">
			<h1>Добавить</h1>
			<div class="add-card">

				<EditForm FormName="addNewTransaction" Model="newTransaction" OnValidSubmit="HandleValidSubmit">
					<DataAnnotationsValidator />

					<div class="add-card-inner">

						<label for="date">Дата: </label>
						<InputDate id="date" @bind-Value="newTransaction.Date" />

						<ValidationMessage For="() => newTransaction.Date" />

						<label for="category">Категория: </label>
						<InputText id="category" @bind-Value="newTransaction.Category" />

						<ValidationMessage For="() => newTransaction.Category" />

				
						<label for="type">Тип: </label>
						<InputSelect id="type" @bind-Value="newTransaction.Type">
							<option value="">Выберите тип</option>
							<option value="@TransactionDto.TransactionType.Income">Доход</option>
							<option value="@TransactionDto.TransactionType.Expense">Трата</option>
						</InputSelect>

						<ValidationMessage For="() => newTransaction.Type" />

						<label for="amount">Сумма: </label>
						<InputNumber id="amount" @bind-Value="newTransaction.Amount" />

						<ValidationMessage For="() => newTransaction.Amount" />

						<label for="description">Описание: </label>
						<InputText id="description" @bind-Value="newTransaction.Description" />

						<ValidationMessage For="() => newTransaction.Description" />

						<button>Добавить</button>
					</div>
				</EditForm>

			</div>

		</div>

		<div class="grid-right responsive-table">
			@if (transactions.Count < 1)
			{
				<h1>У Вас не было транзаций</h1>
			}
			else
			{
				<h1>Транзакции</h1>
				<table>
					<tr>
						<th>Дата</th>
						<th>Категория</th>
						<th>Тип</th>
						<th>Сумма</th>
						<th>Описание</th>
						<th>Действие</th>
					</tr>
					@foreach (var item in transactions)
					{
						<tr>
							<td>@item.Date</td>
							<td>@item.Category</td>
							@if (item.Type == TransactionDto.TransactionType.Expense)
							{
								<th class="expense-text">Трата</th>
							}
							else
							{
								<th class="income-text">Доход</th>
							}
							<td>@item.Amount</td>
							<td>@item.Description</td>
							<td><button class="btn-danger" @onclick="() => DeleteItem(item.Id)">Удалить</button></td>
						</tr>
					}
				</table>
			}

		</div>

	</div>

}

@code {
	private List<TransactionDto>? transactions;

	private TransactionDto newTransaction = new();

	private decimal Incomes => transactions?.Where(t => t.Type == TransactionDto.TransactionType.Income).Sum(t => t.Amount)
?? 0;
	private decimal Expenses => transactions?.Where(t => t.Type == TransactionDto.TransactionType.Expense).Sum(t =>
t.Amount) ?? 0;
	private decimal Balance => Incomes - Expenses;

	protected override async Task OnInitializedAsync()
	{
		await LoadTransactions();
	}

	private async Task LoadTransactions()
	{
		transactions = await TransactionService.GetTransactionsAsync();
	}

	private async Task HandleValidSubmit()
	{
		var result = await TransactionService.AddTransactionAsync(newTransaction);

		if (result.IsSuccess)
		{
			newTransaction = new();
			await LoadTransactions();
		}
	}

	private async Task DeleteItem(Guid guid)
	{
		var result = await TransactionService.DeleteTransactionAsync(guid);

		if (result.IsSuccess)
		{
			await LoadTransactions();
		}
	}
}