@page "/"

@using BlazorAppFin.Client.Shared.DTOs
@using BlazorAppFin.Client.Shared.Interfaces
@using BlazorAppFin.Client.Services;
@using ApexCharts;

@inject ITransactionService TransactionService
@inject ThemeState ThemeState

@implements IDisposable

<PageTitle>Dashboard</PageTitle>


@if (transactions == null)
{
	<h1>Загрузка...</h1>
}
else
{

	<h1>Статистика</h1>

	<div class="overview">

		<div class="overview-card">
			<h2 class="@(Balance < 0 ? "expense-text" : "income-text")">Баланс</h2>
			<h3 class="@(Balance < 0 ? "expense-text" : "income-text")">@Balance</h3>
		</div>

		<div class="overview-card">
			<h2 class="income-text">Доходы</h2>
			<h3 class="income-text">@Incomes</h3>
		</div>

		<div class="overview-card">
			<h2 class="expense-text">Траты</h2>
			<h3 class="expense-text">@Expenses</h3>
		</div>

	</div>

	@if (balanceChartData.Any())
	{
		<div class="chart-card">
			<ApexChart @ref="balanceChart"
					TItem="BalanceHistoryPoint" 
					Title="Динамика баланса"
					Options="balanceChartOptions"
					Height="250"
					Width="380">

				<ApexPointSeries TItem="BalanceHistoryPoint"
								Items="balanceChartData"
								XValue="@(b => b.DateLabel)"
								YValue="@(b => (decimal?) b.BalanceSnapshot)"
								SeriesType="SeriesType.Area"
								Name="Баланс"
								Color="#10b981" /> </ApexChart>
		</div>
	}
	
	<div class="dashboard-grid">

		<div class="grid-left">
			<h1>Добавить</h1>
			<div class="add-card">

				<EditForm FormName="addNewTransaction" Model="newTransaction" OnValidSubmit="HandleValidSubmit">
					<DataAnnotationsValidator />

					<div class="add-card-inner">

						<label for="date">Дата: </label>
						<InputDate id="date" @bind-Value="newTransaction.Date" />

						<ValidationMessage For="() => newTransaction.Date" />

						<label for="category">Категория: </label>
						<InputText id="category" @bind-Value="newTransaction.Category" />

						<ValidationMessage For="() => newTransaction.Category" />

				
						<label for="type">Тип: </label>
						<InputSelect id="type" @bind-Value="newTransaction.Type">
							<option value="">Выберите тип</option>
							<option value="@TransactionDto.TransactionType.Income">Доход</option>
							<option value="@TransactionDto.TransactionType.Expense">Трата</option>
						</InputSelect>

						<ValidationMessage For="() => newTransaction.Type" />

						<label for="amount">Сумма: </label>
						<InputNumber id="amount" @bind-Value="newTransaction.Amount" />

						<ValidationMessage For="() => newTransaction.Amount" />

						<label for="description">Описание: </label>
						<InputText id="description" @bind-Value="newTransaction.Description" />

						<ValidationMessage For="() => newTransaction.Description" />

						<button>Добавить</button>
					</div>
				</EditForm>

			</div>

		</div>

		<div class="grid-right responsive-table">
			@if (transactions.Count < 1)
			{
				<h1>У Вас не было транзаций</h1>
			}
			else
			{
				<h1>Транзакции</h1>

				@if (expensesChartData.Any())
				{
					<div class="chart-card">

						<ApexChart @ref="donutChart"
								TItem="ExpenseSummary" 
								Title="Структура расходов" 
								Options="chartOptions" Height="280"
								Width="380">
							<ApexPointSeries TItem="ExpenseSummary" 
											Items="expensesChartData" 
											XValue="@(e => e.Category)"
											YValue="@(e => e.TotalAmount)" SeriesType="SeriesType.Donut" />
						</ApexChart>

					</div>
				}

				<table>
					<tr>
						<th>Дата</th>
						<th>Категория</th>
						<th>Тип</th>
						<th>Сумма</th>
						<th>Описание</th>
						<th>Действие</th>
					</tr>
					@foreach (var item in transactions)
					{
						<tr>
							<td>@item.Date</td>
							<td>@item.Category</td>
							@if (item.Type == TransactionDto.TransactionType.Expense)
							{
								<th class="expense-text">Трата</th>
							}
							else
							{
								<th class="income-text">Доход</th>
							}
							<td>@item.Amount</td>
							<td>@item.Description</td>
							<td><button class="btn-danger" @onclick="() => DeleteItem(item.Id)">Удалить</button></td>
						</tr>
					}
				</table>
			}

		</div>

	</div>

}

@code {
	private List<TransactionDto>? transactions;
	private List<ExpenseSummary> expensesChartData = [];
	private List<BalanceHistoryPoint> balanceChartData = [];
	
	private ApexChart<BalanceHistoryPoint>? balanceChart;
	private ApexChart<ExpenseSummary>? donutChart;
	private TransactionDto newTransaction = new();

	private decimal Incomes => transactions?
		.Where(t => t.Type == TransactionDto.TransactionType.Income)
		.Sum(t => t.Amount) ?? 0;
	private decimal Expenses => transactions?
		.Where(t => t.Type == TransactionDto.TransactionType.Expense)
		.Sum(t => t.Amount) ?? 0;
	private decimal Balance => Incomes - Expenses;

	protected override async Task OnInitializedAsync()
	{
		ThemeState.OnChange += OnThemeChanged;
		await LoadTransactions();
	}

	private async Task LoadTransactions()
	{
		transactions = await TransactionService.GetTransactionsAsync();

		if (transactions != null && transactions.Any())
		{
			expensesChartData = transactions
				.Where(t => t.Type == TransactionDto.TransactionType.Expense)
				.GroupBy(t => t.Category)
				.Select(g => new ExpenseSummary
				{
					Category = string.IsNullOrEmpty(g.Key) ? "Без категории" : g.Key,
					TotalAmount = g.Sum(t => t.Amount)
				})
				.ToList();

			balanceChartData = new List<BalanceHistoryPoint>();
			decimal runningBalance = 0;

			var sortedTransactions = transactions
				.OrderBy(t => t.Date)
				.ToList();

			foreach (var t in sortedTransactions)
			{
				if (t.Type == TransactionDto.TransactionType.Income)
					runningBalance += t.Amount;
				else
					runningBalance -= t.Amount;

				balanceChartData.Add(new BalanceHistoryPoint
				{
					DateLabel = t.Date,
					BalanceSnapshot = runningBalance
				});

			}

			StateHasChanged();
		}
	}

	private async Task HandleValidSubmit()
	{
		var result = await TransactionService.AddTransactionAsync(newTransaction);

		if (result.IsSuccess)
		{
			newTransaction = new();
			await LoadTransactions();
		}
	}

	private async Task DeleteItem(Guid guid)
	{
		var result = await TransactionService.DeleteTransactionAsync(guid);

		if (result.IsSuccess)
		{
			await LoadTransactions();
		}
	}

	private async void OnThemeChanged()
    {
        StateHasChanged();
        
        if (balanceChart != null) await balanceChart.RenderAsync();
        if (donutChart != null) await donutChart.RenderAsync();
    }

	public void Dispose()
    {
        ThemeState.OnChange -= OnThemeChanged;
    }

	private ApexChartOptions<ExpenseSummary> chartOptions
	{
		get
		{
			return new ApexChartOptions<ExpenseSummary>
			{
				Theme = new Theme
				{
					Mode = ThemeState.IsDark ? Mode.Dark : Mode.Light,
					Palette = PaletteType.Palette1
				},
				Chart = new Chart
				{
					Background = "transparent"
				}
			};
		}
	}

	private ApexChartOptions<BalanceHistoryPoint> balanceChartOptions
	{
		get
		{
			return new ApexChartOptions<BalanceHistoryPoint>
			{
				Theme = new Theme
				{
					Mode = ThemeState.IsDark ? Mode.Dark : Mode.Light,
					Palette = PaletteType.Palette1
				},
				Chart = new Chart
				{
					Background = "transparent",
					Sparkline = new() { Enabled = false }
				},
				Stroke = new Stroke
				{
					Curve = Curve.Smooth,
					Width = 3
				},
				Fill = new Fill
				{
					Type = FillType.Gradient,
					Gradient = new()
					{
						Type = GradientType.Vertical,
						ShadeIntensity = 1,
						OpacityFrom = 0.45,
						OpacityTo = 0.05,
						Stops = [0, 100]
					}
				},
				Xaxis = new XAxis
				{
					Type = XAxisType.Datetime,
					Labels = new XAxisLabels
					{
						Format = "dd.MM",
						DatetimeUTC = false
					}
				},
				Tooltip = new Tooltip
				{
					X = new TooltipX
					{
						Format = "dd.MM.yyyy"
					}
				}
			};
		}
	}

	public class ExpenseSummary
	{
		public string Category { get; set; } = string.Empty;
		public decimal TotalAmount { get; set; }
	}

	public class BalanceHistoryPoint
	{
		public DateTime DateLabel { get; set; }
		public decimal BalanceSnapshot { get; set; }
	}
}