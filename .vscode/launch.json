{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запуск Blazor (Chromium)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BlazorAppFin/BlazorAppFin/bin/Debug/net10.0/BlazorAppFin.dll",
            "args": [],
            "cwd": "${workspaceFolder}/BlazorAppFin/BlazorAppFin",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                // Ловим чистый HTTP порт, игнорируя HTTPS сертификаты
                "pattern": "(http://localhost:\\d+)",
                // Принудительно открываем именно Chromium в CachyOS
                "runtimeExecutable": "/usr/bin/chromium",
                "runtimeArgs": [
                    "--no-first-run",
                    "--no-default-browser-check"
                ]
            }
        }
    ]
}