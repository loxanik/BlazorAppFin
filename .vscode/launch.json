{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запуск Blazor (Сервер + 2 Вкладки)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BlazorAppFin/BlazorAppFin/bin/Debug/net10.0/BlazorAppFin.dll",
            "args": [],
            "cwd": "${workspaceFolder}/BlazorAppFin/BlazorAppFin",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "startDebugging",
                "pattern": "(http://localhost:\\d+)",
                "name": "Запуск Chromium (Две Вкладки)"
            }
        },
        {
            "name": "Запуск Chromium (Две Вкладки)",
            "type": "chrome",
            "request": "launch",
            // Оставляем для дебаггера, чтобы он знал, куда подключаться
            "url": "http://localhost:5263", 
            "runtimeExecutable": "/usr/bin/chromium", 
            "runtimeArgs": [
                "--no-first-run",
                "--no-default-browser-check",
                // Передаем ОФИЦИАЛЬНО ОБЕ ссылки как аргументы запуска:
                "http://localhost:5263",
                "http://localhost:5263/scalar/v1"
            ]
        }
    ]
}